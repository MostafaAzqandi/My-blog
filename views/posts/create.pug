extends ../layouts/layout

block content
    h1 Create New Post
    
    if error
        .error(style="background: #fee; color: #c00; padding: 10px; margin-bottom: 20px; border-radius: 5px;")
            p= error
    
    form(action="/create", method="POST")
        div(style="margin-bottom: 15px;")
            label(for="title", style="display: block; margin-bottom: 5px; font-weight: bold;") Title *
            input(type="text", name="title", id="title", required, value=formData ? formData.title : "", style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;")
        
        div(style="margin-bottom: 15px;")
            label(for="author", style="display: block; margin-bottom: 5px; font-weight: bold;") Author
            input(type="text", name="author", id="author", value=formData ? formData.author : "Anonymous", style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;")
        
        div(style="margin-bottom: 15px;")
            label(for="content", style="display: block; margin-bottom: 5px; font-weight: bold;") Content *
            textarea(name="content", id="content", required, rows="10", style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 5px;")= formData ? formData.content : ""
        
        div(style="margin-bottom: 15px;")
            label(style="display: flex; align-items: center;")
                input(type="checkbox", name="published", style="margin-right: 10px;")
                span Publish immediately
        
        button(type="submit", style="background: #333; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer;") Create Post
    
    hr
    
    a(href="/") ← Back to Home