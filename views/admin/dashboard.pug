extends ../layouts/layout

block content
    h1 Admin Dashboard
    
    .stats-grid(style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px;")
        .stat-card(style="background: #f7fafc; padding: 20px; border-radius: 8px; text-align: center;")
            .stat-number(style="font-size: 36px; font-weight: bold; color: #667eea;") #{stats.totalUsers}
            .stat-label Users
            
        .stat-card(style="background: #f7fafc; padding: 20px; border-radius: 8px; text-align: center;")
            .stat-number(style="font-size: 36px; font-weight: bold; color: #667eea;") #{stats.totalPosts}
            .stat-label Total Posts
            
        .stat-card(style="background: #f7fafc; padding: 20px; border-radius: 8px; text-align: center;")
            .stat-number(style="font-size: 36px; font-weight: bold; color: #48bb78;") #{stats.publishedPosts}
            .stat-label Published
            
        .stat-card(style="background: #f7fafc; padding: 20px; border-radius: 8px; text-align: center;")
            .stat-number(style="font-size: 36px; font-weight: bold; color: #ed8936;") #{stats.draftPosts}
            .stat-label Drafts
    
    .admin-sections(style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;")
        .recent-users
            h2 Recent Users
            table(style="width: 100%; border-collapse: collapse;")
                thead
                    tr
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Username
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Email
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Role
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Status
                tbody
                    each user in recentUsers
                        tr
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") #{user.username}
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") #{user.email}
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") #{user.role}
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") 
                                if user.isActive
                                    span(style="color: #48bb78;") ✓ Active
                                else
                                    span(style="color: #e53e3e;") ✗ Disabled
        
        .recent-posts
            h2 Recent Posts
            table(style="width: 100%; border-collapse: collapse;")
                thead
                    tr
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Title
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Author
                        th(style="text-align: left; padding: 8px; background: #333; color: white;") Status
                tbody
                    each post in recentPosts
                        tr
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") 
                                a(href=`/admin/posts/${post.id}/edit`) #{post.title.substring(0, 50)}
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") #{post.author ? post.author.username : 'Anonymous'}
                            td(style="padding: 8px; border-bottom: 1px solid #ddd;") 
                                if post.published
                                    span(style="color: #48bb78;") Published
                                else
                                    span(style="color: #ed8936;") Draft
    
    .admin-links(style="margin-top: 40px; text-align: center;")
        a.btn(href="/admin/users", style="margin: 0 10px;") Manage Users
        a.btn(href="/admin/posts", style="margin: 0 10px;") Manage Posts